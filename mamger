let annualTab = 'overview';
function switchAnnualTab(tab, el) {
  annualTab = tab;
  document.querySelectorAll('[id^="an-tab-"]').forEach(b => b.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('annual-overview').style.display = tab==='overview' ? 'block' : 'none';
  document.getElementById('annual-compare').style.display = tab==='compare' ? 'block' : 'none';
  document.getElementById('annual-yearly').style.display = tab==='yearly' ? 'block' : 'none';
  if (tab==='overview'||tab==='yearly') renderAnnual();
}

function renderAnnual() {
  const year = +document.getElementById('annual-year').value;
  if (annualTab === 'overview') renderAnnualOverview(year);
  if (annualTab === 'yearly') renderYearlyCompare();
}

function getMonthRevenue(y, m) {
  const prefix = `${y}-${String(m).padStart(2,'0')}`;
  return DB.performances.filter(p => p.date && p.date.startsWith(prefix) && (p.status==='approved'||!p.status))
    .reduce((s,p) => s+Number(p.revenue), 0);
}
function getMonthProfit(y, m) {
  const prefix = `${y}-${String(m).padStart(2,'0')}`;
  const rev = getMonthRevenue(y, m);
  const exp = DB.expenses.filter(e => e.date && e.date.startsWith(prefix)).reduce((s,e)=>s+Number(e.amount),0);
  const staff = DB.staff.filter(s => s.date && s.date.startsWith(prefix));
  const wage = staff.reduce((s,r)=>s+calcHours(r.in,r.out)*HOURLY_RATE,0);
  return rev - exp - wage;
}

function renderAnnualOverview(year) {
  const el = document.getElementById('annual-overview');
  let rows = [];
  let yearTotal = 0;
  for (let m = 1; m <= 12; m++) {
    const rev = getMonthRevenue(year, m);
    const profit = getMonthProfit(year, m);
    const prevRev = m > 1 ? getMonthRevenue(year, m-1) : null;
    const growth = prevRev !== null && prevRev > 0 ? ((rev-prevRev)/prevRev*100).toFixed(1) : null;
    yearTotal += rev;
    rows.push({ m, rev, profit, growth });
  }

  let html = `<div class="report-card">
    <div class="report-header"><span>📅 ${year}年 月度總覽</span><span>合計 $${fmt(yearTotal)}</span></div>
    ${rows.map(r => `
    <div class="month-row">
      <div>
        <div style="font-weight:700">${r.m} 月</div>
        ${r.growth !== null ? `<div class="${Number(r.growth)>=0?'growth-up':'growth-down'}">${Number(r.growth)>=0?'▲':'▼'} ${Math.abs(r.growth)}% vs 上月</div>` : ''}
      </div>
      <div style="text-align:right">
        <div style="font-weight:900;color:${r.rev>0?'var(--ink)':'var(--muted)'}">${r.rev>0?'$'+fmt(r.rev):'—'}</div>
        ${r.rev>0?`<div style="font-size:11px;color:${r.profit>=0?'var(--green)':'var(--red);'}">${r.profit>=0?'+':''}$${fmt(r.profit)}</div>`:''}
      </div>
    </div>`).join('')}
  </div>`;
  el.innerHTML = html;
}

function renderCompare() {
  const a = document.getElementById('cmp-a').value;
  const b = document.getElementById('cmp-b').value;
  if (!a || !b) return;

  const getStats = (month) => {
    const [y, m] = month.split('-').map(Number);
    const rev = getMonthRevenue(y, m);
    const profit = getMonthProfit(y, m);
    const days = DB.performances.filter(p => p.date && p.date.startsWith(month)).length;
    return { rev, profit, days, avg: days > 0 ? Math.round(rev/days) : 0 };
  };

  const sa = getStats(a);
  const sb = getStats(b);
  const revDiff = sb.rev - sa.rev;
  const revGrowth = sa.rev > 0 ? ((revDiff/sa.rev)*100).toFixed(1) : null;
  const profitDiff = sb.profit - sa.profit;

  const el = document.getElementById('compare-result');
  el.innerHTML = `
  <div class="report-card">
    <div class="report-header" style="background:var(--blue)">📊 比較結果：${a} vs ${b}</div>
    <div style="display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid var(--border)">
      <div style="padding:14px 16px;border-right:1px solid var(--border)">
        <div style="font-size:11px;color:var(--muted);margin-bottom:6px">${a}</div>
        <div style="font-size:20px;font-weight:900;color:var(--green)">$${fmt(sa.rev)}</div>
        <div style="font-size:12px;color:var(--muted);margin-top:4px">毛利 $${fmt(sa.profit)}</div>
        <div style="font-size:12px;color:var(--muted)">營業 ${sa.days} 天 ∙ 日均 $${fmt(sa.avg)}</div>
      </div>
      <div style="padding:14px 16px">
        <div style="font-size:11px;color:var(--muted);margin-bottom:6px">${b}</div>
        <div style="font-size:20px;font-weight:900;color:var(--green)">$${fmt(sb.rev)}</div>
        <div style="font-size:12px;color:var(--muted);margin-top:4px">毛利 $${fmt(sb.profit)}</div>
        <div style="font-size:12px;color:var(--muted)">營業 ${sb.days} 天 ∙ 日均 $${fmt(sb.avg)}</div>
      </div>
    </div>
    <div class="report-row" style="background:${revDiff>=0?'var(--green-light)':'var(--warn-light)'}">
      <span style="font-weight:700">營業額成長</span>
      <span style="font-size:18px;font-weight:900;color:${revDiff>=0?'var(--green)':'var(--red)'}">
        ${revDiff>=0?'+':''}$${fmt(revDiff)}
        ${revGrowth !== null ? `<span style="font-size:12px;font-weight:700">(${revGrowth>=0?'+':''}${revGrowth}%)</span>` : ''}
      </span>
    </div>
    <div class="report-row">
      <span class="report-key">毛利變化</span>
      <span class="report-val" style="color:${profitDiff>=0?'var(--green)':'var(--red)'}">${profitDiff>=0?'+':''}$${fmt(profitDiff)}</span>
    </div>
    <div class="report-row">
      <span class="report-key">日均營業額變化</span>
      <span class="report-val" style="color:${sb.avg-sa.avg>=0?'var(--green)':'var(--red)'}">${sb.avg-sa.avg>=0?'+':''}$${fmt(sb.avg-sa.avg)}</span>
    </div>
  </div>`;
}

function renderYearlyCompare() {
  const el = document.getElementById('annual-yearly');
  const cy = new Date().getFullYear();
  let rows = [];
  for (let y = cy; y >= cy-4; y--) {
    let total = 0;
    for (let m = 1; m <= 12; m++) total += getMonthRevenue(y, m);
    rows.push({ y, total });
  }

  let html = `<div class="report-card"><div class="report-header">📈 年度對比（近5年）</div>`;
  rows.forEach((r, i) => {
    const prev = rows[i+1];
    const growth = prev && prev.total > 0 ? ((r.total-prev.total)/prev.total*100).toFixed(1) : null;
    html += `<div class="month-row">
      <div>
        <div style="font-weight:700">${r.y} 年</div>
        ${growth !== null ? `<div class="${Number(growth)>=0?'growth-up':'growth-down'}">${Number(growth)>=0?'▲':'▼'} ${Math.abs(growth)}% vs ${r.y-1}年</div>` : ''}
      </div>
      <div style="font-size:18px;font-weight:900;color:${i===0?'var(--red)':'var(--ink)'}">${r.total>0?'$'+fmt(r.total):'—'}</div>
    </div>`;
  });
  html += '</div>';
  el.innerHTML = html;
}

