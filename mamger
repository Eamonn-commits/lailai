function generateReport() {
  const el = document.getElementById('reportContent');
  if (!el) return;
  const month = document.getElementById('reportMonth').value || today().slice(0,7);
  const [yr, mo] = month.split('-').map(Number);

  const expenses = DB.expenses.filter(e => e.date && e.date.startsWith(month) && (e.status==='approved'||!e.status));
  const perfs = DB.performances.filter(p => p.date && p.date.startsWith(month) && (p.status==='approved'||!p.status));
  const staff = DB.staff.filter(s => s.date && s.date.startsWith(month));

  const totalExpense = expenses.reduce((s,e) => s+Number(e.amount), 0);
  const totalRevenue = perfs.reduce((s,p) => s+Number(p.revenue), 0);
  const totalHours = staff.reduce((s,r) => s+calcHours(r.in,r.out), 0);
  const totalWage = totalHours * HOURLY_RATE;
  const totalAllExpense = totalExpense + totalWage;
  const totalProfit = totalRevenue - totalAllExpense;
  const scallionTotal = perfs.reduce((s,p) => s+Number(p.scallion||0), 0);
  const dumplingTotal = perfs.reduce((s,p) => s+Number(p.dumpling||0), 0);
  const workDays = perfs.length;
  const avgDaily = workDays > 0 ? Math.round(totalRevenue / workDays) : 0;
  const marginPct = totalRevenue > 0 ? ((totalProfit/totalRevenue)*100).toFixed(1) : 0;
  const expRatio = totalRevenue > 0 ? (totalExpense/totalRevenue*100).toFixed(1) : 0;
  const wageRatio = totalRevenue > 0 ? (totalWage/totalRevenue*100).toFixed(1) : 0;

  // Cat breakdown
  const catBreakdown = {};
  expenses.forEach(e => { catBreakdown[e.cat] = (catBreakdown[e.cat]||0)+Number(e.amount); });
  if (totalWage > 0) catBreakdown['💵 員工薪資'] = totalWage;

  const warns = expenses.filter(e => e.warn);
  const staffHours = {};
  staff.forEach(s => { const h=calcHours(s.in,s.out); staffHours[s.name]=(staffHours[s.name]||0)+h; });
  const topStaff = Object.entries(staffHours).filter(([,h])=>h>0).sort((a,b)=>b[1]-a[1]);

  // Alert levels
  const expLevel = Number(expRatio) <= 35 ? 'good' : Number(expRatio) <= 50 ? 'ok' : 'bad';
  const expLevelLabel = Number(expRatio) <= 35 ? '優良' : Number(expRatio) <= 50 ? '尚可' : '欠佳';
  const wageLevel = Number(wageRatio) <= 25 ? 'good' : Number(wageRatio) <= 35 ? 'ok' : 'bad';
  const wageLevelLabel = Number(wageRatio) <= 25 ? '優良' : Number(wageRatio) <= 35 ? '尚可' : '欠佳';

  let html = `
  <div class="report-card">
    <div class="report-header"><span>📅 ${yr}年${mo}月 月報</span><span>${workDays} 營業天</span></div>
    <div class="stats-grid">
      <div class="stat-cell"><div class="stat-label">📈 總營業額</div><div class="stat-value" style="color:var(--green)">$${fmt(totalRevenue)}</div></div>
      <div class="stat-cell"><div class="stat-label">💰 實賺金額</div><div class="stat-value ${totalProfit>=0?'profit-positive':'profit-negative'}" style="font-size:18px">${totalProfit>=0?'+':''}$${fmt(totalProfit)}</div></div>
      <div class="stat-cell"><div class="stat-label">📊 毛利率</div><div class="stat-value">${marginPct}%</div></div>
      <div class="stat-cell"><div class="stat-label">📆 平均每日</div><div class="stat-value">$${fmt(avgDaily)}</div></div>
    </div>
    <div class="report-row"><span class="report-key">📦 進貨＋管銷</span><span class="report-val" style="color:var(--muted)">$${fmt(totalExpense)}</span></div>
    <div class="report-row"><span class="report-key">💵 員工薪資</span><span class="report-val" style="color:var(--muted)">$${fmt(totalWage)}</span></div>
    <div class="report-row" style="background:#f9f6f1"><span class="report-key" style="font-weight:900">💸 總支出合計</span><span class="report-val" style="color:var(--red)">$${fmt(totalAllExpense)}</span></div>
  </div>

  <div class="report-card">
    <div class="report-header" style="background:var(--gold)">⚠️ 佔比健康分析</div>
    <div style="padding:14px 16px">
      <div class="alert-box alert-${expLevel}" style="margin-bottom:10px">
        📦 <div><div style="font-weight:700">進貨佔比 ${expRatio}% ── <span>${expLevelLabel}</span></div><div style="font-size:11px;color:var(--muted);margin-top:2px">建議控制在 35% 以內</div></div>
      </div>
      <div class="alert-box alert-${wageLevel}">
        👥 <div><div style="font-weight:700">人事佔比 ${wageRatio}% ── <span>${wageLevelLabel}</span></div><div style="font-size:11px;color:var(--muted);margin-top:2px">建議控制在 25% 以內</div></div>
      </div>
    </div>
  </div>

  <div class="report-card">
    <div class="report-header">🏆 銷售統計</div>
    <div class="report-row"><span class="report-key">🧅 蔥抓餅合計</span><span class="report-val">${fmt(scallionTotal)} 顆</span></div>
    <div class="report-row"><span class="report-key">🥟 小籠包合計</span><span class="report-val">${fmt(dumplingTotal)} 籠</span></div>
    <div class="report-row"><span class="report-key">📅 營業天數</span><span class="report-val">${workDays} 天</span></div>
    <div class="report-row"><span class="report-key">📊 平均每日營業額</span><span class="report-val">$${fmt(avgDaily)}</span></div>
  </div>

  <div class="report-card">
    <div class="report-header">📦 支出分類佔比</div>
    <div class="bar-wrap">
      ${Object.entries(catBreakdown).sort((a,b)=>b[1]-a[1]).map(([cat,amt]) => `
      <div class="bar-row">
        <div class="bar-label"><span>${cat}</span><span>$${fmt(amt)}</span></div>
        <div class="bar-track"><div class="bar-fill" style="width:${totalAllExpense>0?(amt/totalAllExpense*100).toFixed(0):0}%"></div></div>
      </div>`).join('')}
    </div>
  </div>

  ${warns.length > 0 ? `
  <div class="report-card">
    <div class="report-header" style="background:var(--warn)">⛔️ 本月漲價項目（${warns.length}筆）</div>
    ${warns.map(w=>`<div class="report-row"><span class="report-key">${w.name}</span><span class="report-val" style="color:var(--warn);font-size:12px">${w.warn}</span></div>`).join('')}
  </div>` : ''}

  <div class="report-card">
    <div class="report-header">👥 員工工時＆薪資</div>
    ${topStaff.length > 0 ? topStaff.map(([name,h]) => `
    <div class="report-row">
      <span class="report-key" style="font-weight:700">${name}</span>
      <span><span class="hours-badge">${h.toFixed(1)}h</span> <span style="font-weight:900;color:var(--red);margin-left:6px">$${fmt(h*HOURLY_RATE)}</span></span>
    </div>`).join('') : `<div class="empty"><div class="empty-text">尚無出勤記錄</div></div>`}
    ${totalHours > 0 ? `<div class="report-row" style="background:var(--red-light)">
      <span class="report-key" style="font-weight:900">月薪資合計 (${totalHours.toFixed(1)}h)</span>
      <span style="font-size:18px;font-weight:900;color:var(--red)">$${fmt(totalWage)}</span>
    </div>` : ''}
  </div>`;

  el.innerHTML = html;
}

