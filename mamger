  document.getElementById('staff-selected-display').textContent = '已選：' + name;
}

function openManageStaff() { renderStaffListEdit(); document.getElementById('modal-manage-staff').classList.add('open'); }
function renderStaffListEdit() {
  const list = getStaffList();
  document.getElementById('staff-list-edit').innerHTML = list.map((name,i) =>
