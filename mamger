<script>
// ══════════════════════════════
// CONSTANTS
// ══════════════════════════════
const HOURLY_RATE = 200;
const DEFAULT_STAFF = ['蔡老闆','馮老闆','賢','文玲','淑儀','聖韻','睿恩','偉翰','小玉'];

// ══════════════════════════════
// LOCAL DB (cache)
// ══════════════════════════════
let DB = { expenses: [], performances: [], staff: [] };

function loadLocalDB() {
  const raw = localStorage.getItem('lailaiDB_v2');
  if (raw) DB = JSON.parse(raw);
}

function saveLocalDB() {
  localStorage.setItem('lailaiDB_v2', JSON.stringify(DB));
}

// ══════════════════════════════
// SETUP
// ══════════════════════════════
function startApp() {
  const brand = document.getElementById('setup-brand').value.trim() || '萊萊蔥抓餅';
  localStorage.setItem('lailai_brand', brand);
  document.getElementById('setup-screen').style.display = 'none';
  initApp(brand);
}

function initApp(brand) {
  document.getElementById('header-brand').textContent = '🥟 ' + brand;
  document.getElementById('main-header').style.display = 'flex';
  document.getElementById('main-tabs').style.display = 'flex';
  updateHeaderDate();
  loadLocalDB();
  const t = today();
  document.getElementById('expenseDate').value = t;
  document.getElementById('perfDate').value = t;
  document.getElementById('staffDate').value = t;
  document.getElementById('reportMonth').value = t.slice(0,7);
  expenseCurrentDate = t;
  perfCurrentDate = t;
  staffCurrentDate = t;

  // populate year selects
  const cy = new Date().getFullYear();
  const ySel = document.getElementById('annual-year');
  for (let y = cy; y >= cy - 5; y--) {
    ySel.innerHTML += `<option value="${y}">${y}年</option>`;
  }
  const cmpA = document.getElementById('cmp-a');
  const cmpB = document.getElementById('cmp-b');
  const pm = t.slice(0,7);
  cmpB.value = pm;
  const prevM = new Date(cy, new Date().getMonth() - 1, 1);
  cmpA.value = prevM.toISOString().slice(0,7);

  renderExpenses();
  renderPerf();
  renderStaff();

  // sync from Firebase if ready
  if (window._fbReady) syncAll();
  else document.addEventListener('firebase-ready', syncAll);
}

// ══════════════════════════════
// FIREBASE SYNC
// ══════════════════════════════
async function syncAll() {
  if (!window._db) { showSyncStatus('⚠ 未設定Firebase', 'var(--orange)'); return; }
  showSyncStatus('⟳ 同步中...', 'var(--orange)');
  try {
    const { collection, getDocs } = window._fs;
    const db = window._db;
    const [expSnap, perfSnap, staffSnap] = await Promise.all([
      getDocs(collection(db, 'expenses')),
      getDocs(collection(db, 'performances')),
      getDocs(collection(db, 'staff')),
    ]);
    DB.expenses = expSnap.docs.map(d => ({ ...d.data(), _fid: d.id }));
    DB.performances = perfSnap.docs.map(d => ({ ...d.data(), _fid: d.id }));
    DB.staff = staffSnap.docs.map(d => ({ ...d.data(), _fid: d.id }));
    saveLocalDB();
    showSyncStatus('✓ 已同步', 'var(--green)');
    renderExpenses(); renderPerf(); renderStaff(); generateReport();
  } catch(e) {
    showSyncStatus('✗ 同步失敗', 'var(--red)');
    console.error(e);
  }
}

async function pushRecord(collName, data) {
  if (!window._db) {
    saveLocalDB();
    showSyncStatus('本機儲存', 'var(--orange)');
    return null;
  }
  try {
    const { collection, addDoc } = window._fs;
    const ref = await addDoc(collection(window._db, collName), data);
    showSyncStatus('✓ 已儲存', 'var(--green)');
    return ref.id;
  } catch(e) {
    showSyncStatus('✗ 儲存失敗', 'var(--red)');
    console.error(e);
    return null;
  }
}

async function deleteRecord(collName, localId, fid) {
  DB[collName] = DB[collName].filter(r => String(r.id) !== String(localId));
  saveLocalDB();
  if (window._db && fid) {
    try {
      const { doc, deleteDoc } = window._fs;
      await deleteDoc(doc(window._db, collName, fid));
    } catch(e) { console.error(e); }
  }
}

// ══════════════════════════════
// UTILITIES
// ══════════════════════════════
function today() { return new Date().toISOString().slice(0,10); }
function fmt(n) { return Number(n).toLocaleString(); }
function calcHours(inT, outT) {
  if (!inT || !outT) return 0;
  const [ih,im] = inT.split(':').map(Number);
  const [oh,om] = outT.split(':').map(Number);
  let diff = (oh*60+om) - (ih*60+im);
  if (diff < 0) diff += 1440;
  return diff / 60;
}
function updateHeaderDate() {
  const d = new Date();
  document.getElementById('headerDate').textContent =
    `${d.getMonth()+1}/${d.getDate()} (${['日','一','二','三','四','五','六'][d.getDay()]})`;
}
function showSyncStatus(msg, color='var(--orange)') {
  const el = document.getElementById('sync-status');
  el.textContent = msg; el.style.color = color; el.style.opacity = '1';
  if (color !== 'var(--orange)') setTimeout(() => { el.style.opacity='0'; }, 2500);
}

// ══════════════════════════════
// TAB SWITCHING
// ══════════════════════════════
function switchTab(tab, el) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('tab-'+tab).classList.add('active');
  if (tab === 'report') { generateReport(); }
  if (tab === 'annual') { renderAnnual(); }
}

let currentMode = 'view';
function setMode(m) {
  currentMode = m;
  document.getElementById('mode-view').classList.toggle('active', m==='view');
  document.getElementById('mode-add').classList.toggle('active', m==='add');
  document.getElementById('addExpenseArea').style.display = m==='add' ? 'block' : 'none';
  renderExpenses();
}

let perfMode = 'view';
function setPerfMode(m) {
  perfMode = m;
  document.getElementById('perfmode-view').classList.toggle('active', m==='view');
  document.getElementById('perfmode-add').classList.toggle('active', m==='add');
  document.getElementById('addPerfArea').style.display = m==='add' ? 'block' : 'none';
  renderPerf();
}

let staffMode = 'view';
function setStaffMode(m) {
  staffMode = m;
  document.getElementById('staffmode-view').classList.toggle('active', m==='view');
  document.getElementById('staffmode-add').classList.toggle('active', m==='add');
  document.getElementById('addStaffArea').style.display = m==='add' ? 'block' : 'none';
  renderStaff();
}

// ══════════════════════════════
// EXPENSE
// ══════════════════════════════
let expenseCurrentDate = today();
function loadDay() {
  expenseCurrentDate = document.getElementById('expenseDate').value || today();
  renderExpenses();
}

function renderExpenses() {
  const date = expenseCurrentDate;
  const items = DB.expenses.filter(e => e.date === date && (e.status === 'approved' || !e.status));
  const cats = {};
  items.forEach(item => { if (!cats[item.cat]) cats[item.cat]=[]; cats[item.cat].push(item); });

  let html = '';
  let total = 0;
  if (items.length === 0) html = `<div class="empty"><div class="empty-icon">📋</div><div class="empty-text">這天還沒有支出記錄</div></div>`;

  const catColors = { '食材原料':'red','包裝耗材':'gold','飲品原料':'green','店面管銷成本':'mgmt','其他':'orange' };
  const catIcons = { '食材原料':'🥩','包裝耗材':'📦','飲品原料':'🧋','店面管銷成本':'🏪','其他':'📋' };

  Object.keys(cats).forEach(cat => {
    html += `<div class="card"><div class="card-header ${catColors[cat]||'orange'}">${catIcons[cat]||'📋'} ${cat}</div>
      <table class="expense-table"><tr><th>品項</th><th>數量</th><th style="text-align:right">金額</th><th></th></tr>`;
    cats[cat].forEach(item => {
      total += Number(item.amount);
      html += `<tr>
        <td>${item.name}${item.warn?`<span class="warn-badge">⛔️漲</span><span class="note">${item.warn}</span>`:''}</td>
        <td style="color:var(--muted);font-size:12px">${item.qty||'-'}</td>
        <td class="amt">$${fmt(item.amount)}</td>
        <td><button onclick="doDeleteExpense('${item.id}','${item._fid||''}')" style="background:none;border:none;color:#ccc;font-size:16px;cursor:pointer;padding:0 4px">✕</button></td>
      </tr>`;
    });
    html += `</table></div>`;
  });

  if (items.length > 0) html += `<div class="card"><table class="expense-table"><tr class="total-row"><td colspan="2">💰 當日支出總計</td><td class="amt">$${fmt(total)}</td></tr></table></div>`;
  document.getElementById('expenseList').innerHTML = html;
}

async function submitExpense() {
  const data = {
    date: document.getElementById('exp-date').value || today(),
    cat: document.getElementById('exp-cat').value,
    name: document.getElementById('exp-name').value,
    amount: document.getElementById('exp-amount').value,
    qty: document.getElementById('exp-qty').value,
    warn: document.getElementById('exp-warn').value,
    who: document.getElementById('exp-who').value,
    status: 'approved', id: Date.now()
  };
  if (!data.name || !data.amount) { alert('請填寫品項和金額'); return; }
  const fid = await pushRecord('expenses', data);
  DB.expenses.push({ ...data, _fid: fid });
  saveLocalDB();
  expenseCurrentDate = data.date;
  document.getElementById('expenseDate').value = data.date;
  renderExpenses();
  closeModal('expense');
  ['exp-name','exp-amount','exp-qty','exp-warn','exp-who'].forEach(id => document.getElementById(id).value='');
}

async function doDeleteExpense(id, fid) {
  if (!confirm('確定刪除？')) return;
  await deleteRecord('expenses', id, fid);
  renderExpenses(); generateReport();
}

// ══════════════════════════════
// PERFORMANCE
// ══════════════════════════════
let perfCurrentDate = today();
function loadPerfDay() {
  perfCurrentDate = document.getElementById('perfDate').value || today();
  renderPerf();
}

function renderPerf() {
  const date = perfCurrentDate;
  const rec = DB.performances.find(p => p.date===date && (p.status==='approved'||!p.status));
  let html = '';
  if (!rec) {
    html = `<div class="empty"><div class="empty-icon">📊</div><div class="empty-text">這天還沒有戰績資料</div></div>`;
  } else {
    const totalExp = Number(rec.purchase)+Number(rec.other||0);
    const revenue = Number(rec.revenue);
    const profit = revenue - totalExp;
    const margin = revenue > 0 ? ((profit/revenue)*100).toFixed(1) : 0;
    const expRatio = revenue > 0 ? (totalExp/revenue*100).toFixed(1) : 0;

    html = `<div class="card">
      <div class="card-header green" style="display:flex;justify-content:space-between">
        <span>🏆 當日戰績</span>
        <button onclick="doDeletePerf('${rec.id}','${rec._fid||''}')" style="background:rgba(255,255,255,.25);border:none;color:white;font-size:12px;padding:3px 8px;border-radius:4px;cursor:pointer;font-family:inherit">✕ 刪除</button>
      </div>
      <div class="perf-grid">
        <div class="perf-cell"><div class="perf-label">🧅 蔥抓餅</div><div class="perf-value">${fmt(rec.scallion)}<span class="perf-unit">顆</span></div></div>
        <div class="perf-cell"><div class="perf-label">🥟 小籠包</div><div class="perf-value">${fmt(rec.dumpling)}<span class="perf-unit">籠</span></div></div>
        <div class="perf-cell"><div class="perf-label">💸 總支出</div><div class="perf-value red">$${fmt(totalExp)}</div></div>
        <div class="perf-cell"><div class="perf-label">💰 營業額</div><div class="perf-value green">$${fmt(revenue)}</div></div>
      </div>
    </div>
    <div class="card">
      <div class="card-header gold">📈 損益概況</div>
      <div style="padding:16px;text-align:center;margin-bottom:8px">
        <div style="font-size:12px;color:var(--muted);margin-bottom:4px">預估毛利</div>
        <div class="${profit>=0?'profit-positive':'profit-negative'}">${profit>=0?'+':''}$${fmt(profit)}</div>
        <div style="font-size:11px;color:var(--muted);margin-top:4px">毛利率 ${margin}%</div>
      </div>
      <div class="bar-wrap">
        <div class="bar-row">
          <div class="bar-label"><span>進貨支出佔比</span><span>${expRatio}%</span></div>
          <div class="bar-track"><div class="bar-fill" style="width:${Math.min(expRatio,100)}%;background:${expRatio>50?'var(--warn)':expRatio>35?'var(--orange)':'var(--green)'}"></div></div>
        </div>
      </div>
      ${Number(expRatio) > 50 ? `<div style="padding:0 16px 14px"><div class="alert-box alert-bad">⚠️ 進貨佔比過高（${expRatio}%），建議控制在 40% 以內</div></div>` :
        Number(expRatio) > 35 ? `<div style="padding:0 16px 14px"><div class="alert-box alert-ok">📌 進貨佔比尚可（${expRatio}%），仍有優化空間</div></div>` :
        `<div style="padding:0 16px 14px"><div class="alert-box alert-good">✅ 進貨佔比良好（${expRatio}%）</div></div>`}
    </div>
    ${rec.note ? `<div class="card"><div style="padding:12px 16px;font-size:13px">📝 ${rec.note}</div></div>` : ''}`;
  }
  document.getElementById('perfDisplay').innerHTML = html;
}

async function submitPerf() {
  const data = {
    date: document.getElementById('perf-date').value || today(),
    scallion: document.getElementById('perf-scallion').value,
    dumpling: document.getElementById('perf-dumpling').value,
    purchase: document.getElementById('perf-purchase').value,
    other: document.getElementById('perf-other').value,
    revenue: document.getElementById('perf-revenue').value,
    note: document.getElementById('perf-note').value,
    who: document.getElementById('perf-who').value,
    status: 'approved', id: Date.now()
  };
  if (!data.revenue) { alert('請填寫營業額'); return; }
  const fid = await pushRecord('performances', data);
  DB.performances.push({ ...data, _fid: fid });
  saveLocalDB();
  perfCurrentDate = data.date;
  document.getElementById('perfDate').value = data.date;
  renderPerf(); generateReport();
  closeModal('perf');
}

async function doDeletePerf(id, fid) {
  if (!confirm('確定刪除？')) return;
  await deleteRecord('performances', id, fid);
  renderPerf(); generateReport();
}

// ══════════════════════════════
// STAFF
// ══════════════════════════════
let staffCurrentDate = today();
function loadStaffDay() {
  staffCurrentDate = document.getElementById('staffDate').value || today();
  renderStaff();
}

function renderStaff() {
  const date = staffCurrentDate;
  const records = DB.staff.filter(s => s.date===date);
  let html = '';
  let totalHours = 0, totalWage = 0;

  if (!records.length) {
    html = `<div class="empty"><div class="empty-icon">👥</div><div class="empty-text">這天還沒有出勤記錄</div></div>`;
  } else {
    html = `<div class="card"><div class="card-header mgmt">👥 出勤紀錄</div>
      <table class="staff-table">
        <tr><th>姓名</th><th>狀態</th><th>工時</th><th>薪資</th><th></th></tr>`;
    records.forEach(s => {
      const h = calcHours(s.in, s.out);
      totalHours += h;
      const wage = h * HOURLY_RATE;
      totalWage += wage;
      const statusLabel = { work:'出勤', leave:'事假', sick:'病假', absent:'未到' }[s.status_val||s.status] || '出勤';
      const badgeCls = s.status_val==='work'||s.status==='work' ? 'badge-work' : s.status_val==='leave'||s.status==='leave' ? 'badge-leave' : 'badge-absent';
      html += `<tr>
        <td style="font-weight:700">${s.name}</td>
        <td><span class="badge ${badgeCls}">${statusLabel}</span></td>
        <td>${h > 0 ? `<span class="hours-badge">${h.toFixed(1)}h</span>` : '-'}</td>
        <td style="font-weight:700;color:var(--red)">${wage > 0 ? '$'+fmt(wage) : '-'}</td>
        <td><button onclick="doDeleteStaff('${s.id}','${s._fid||''}')" style="background:none;border:none;color:#ccc;font-size:16px;cursor:pointer">✕</button></td>
      </tr>`;
    });
    html += `</table></div>`;
    if (totalHours > 0) {
      html += `<div class="card"><div class="card-header gold">💵 當日薪資總覽</div>
        <div style="padding:12px 16px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between">
          <span style="font-size:13px;color:var(--muted)">總出勤工時</span><span class="hours-badge" style="font-size:14px">${totalHours.toFixed(1)} 小時</span>
        </div>
        <div style="padding:14px 16px;background:var(--red-light);display:flex;justify-content:space-between">
          <span style="font-size:15px;font-weight:900;color:var(--red)">💰 當日薪資合計</span>
          <span style="font-size:20px;font-weight:900;color:var(--red)">$${fmt(totalWage)}</span>
        </div>
      </div>`;
    }
  }
  document.getElementById('staffDisplay').innerHTML = html;
}

async function submitStaff() {
  const data = {
    date: document.getElementById('staff-date').value || today(),
    name: document.getElementById('staff-name').value,
    status_val: document.getElementById('staff-status').value,
    in: document.getElementById('staff-in').value,
    out: document.getElementById('staff-out').value,
    note: document.getElementById('staff-note').value,
    who: document.getElementById('staff-who').value,
    id: Date.now()
  };
  if (!data.name) { alert('請選擇員工姓名'); return; }
  const fid = await pushRecord('staff', data);
  DB.staff.push({ ...data, _fid: fid });
  saveLocalDB();
  staffCurrentDate = data.date;
  document.getElementById('staffDate').value = data.date;
  renderStaff(); generateReport();
  closeModal('staff');
}

async function doDeleteStaff(id, fid) {
  if (!confirm('確定刪除？')) return;
  await deleteRecord('staff', id, fid);
  renderStaff(); generateReport();
}

