function runSearch() {
  const kw = document.getElementById('search-keyword').value.trim().toLowerCase();
  const cat = document.getElementById('search-cat').value;
  const from = document.getElementById('search-date-from').value;
  const to = document.getElementById('search-date-to').value;

  let results = DB.expenses.filter(e => {
    const matchKw = !kw || e.name.toLowerCase().includes(kw);
    const matchCat = !cat || e.cat === cat;
    const matchFrom = !from || e.date >= from;
    const matchTo = !to || e.date <= to;
    return matchKw && matchCat && matchFrom && matchTo;
  }).sort((a,b) => b.date.localeCompare(a.date));

  const summary = document.getElementById('search-summary');
  const container = document.getElementById('search-results');

  if (!results.length) {
    summary.innerHTML = '';
    container.innerHTML = `<div class="empty"><div class="empty-icon">🔍</div><div class="empty-text">找不到符合的項目</div></div>`;
    return;
  }

  const totalAmt = results.reduce((s,e) => s+Number(e.amount), 0);
  const avgAmt = totalAmt / results.length;
  const minItem = results.reduce((a,b) => Number(a.amount)<Number(b.amount)?a:b);
  const maxItem = results.reduce((a,b) => Number(a.amount)>Number(b.amount)?a:b);

  summary.innerHTML = `<div class="card">
    <div class="card-header red">📊 搜尋結果統計（${results.length} 筆）</div>
    <div style="display:grid;grid-template-columns:1fr 1fr">
      <div style="padding:12px 16px;border-right:1px solid var(--border);border-bottom:1px solid var(--border)">
        <div style="font-size:11px;color:var(--muted);font-weight:700;margin-bottom:4px">最低價</div>
        <div style="font-size:16px;font-weight:900;color:var(--green)">$${fmt(minItem.amount)}</div>
        <div style="font-size:11px;color:var(--muted)">${minItem.date}</div>
      </div>
      <div style="padding:12px 16px;border-bottom:1px solid var(--border)">
        <div style="font-size:11px;color:var(--muted);font-weight:700;margin-bottom:4px">最高價</div>
        <div style="font-size:16px;font-weight:900;color:var(--red)">$${fmt(maxItem.amount)}</div>
        <div style="font-size:11px;color:var(--muted)">${maxItem.date}</div>
      </div>
      <div style="padding:12px 16px;border-right:1px solid var(--border)">
        <div style="font-size:11px;color:var(--muted);font-weight:700;margin-bottom:4px">平均價</div>
        <div style="font-size:16px;font-weight:900">$${fmt(Math.round(avgAmt))}</div>
      </div>
      <div style="padding:12px 16px">
        <div style="font-size:11px;color:var(--muted);font-weight:700;margin-bottom:4px">合計</div>
        <div style="font-size:16px;font-weight:900">$${fmt(totalAmt)}</div>
      </div>
    </div>
  </div>`;

  let html = `<div class="card"><div class="card-header gold">📋 明細（新→舊）</div>
    <table class="expense-table"><tr><th>日期</th><th>品項</th><th>數量</th><th style="text-align:right">金額</th></tr>`;
  results.forEach(e => {
    html += `<tr>
      <td style="font-size:12px;color:var(--muted);white-space:nowrap">${e.date}</td>
      <td>${e.name}${e.warn?`<span class="warn-badge">⛔️漲</span>`:''}<span style="font-size:10px;color:var(--muted);display:block">${e.cat}</span></td>
      <td style="font-size:12px;color:var(--muted)">${e.qty||'-'}</td>
      <td class="amt">$${fmt(e.amount)}</td>
    </tr>`;
  });
  html += '</table></div>';
  container.innerHTML = html;
}

