<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>萊萊蔥抓餅｜營運管理系統</title>

<!-- Firebase SDK -->
<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
  import { getFirestore, collection, addDoc, getDocs, deleteDoc, doc, query, where, orderBy, onSnapshot, setDoc, getDoc }
    from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";
  import { getAuth, signInWithEmailAndPassword, signOut, onAuthStateChanged }
    from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";

  const firebaseConfig = {
    apiKey: "AIzaSyAU6JGR2F3SP5TNRU1wKJRNpErYwL-emJo",
    authDomain: "lailai-manager.firebaseapp.com",
    projectId: "lailai-manager",
    storageBucket: "lailai-manager.firebasestorage.app",
    messagingSenderId: "400764876175",
    appId: "1:400764876175:web:3c4f0534d3e80dfb90c7fa"
  };

  const app  = initializeApp(firebaseConfig);
  const db   = getFirestore(app);
  const auth = getAuth(app);

  window._db   = db;
  window._auth = auth;
  window._fs   = { collection, addDoc, getDocs, deleteDoc, doc, query, where, orderBy, onSnapshot, setDoc, getDoc };

  onAuthStateChanged(auth, (user) => {
    if (user) {
      document.getElementById('login-screen').style.display  = 'none';
      document.getElementById('setup-screen').style.display  = 'none';
      document.getElementById('main-header').style.display   = 'flex';
      document.getElementById('main-tabs').style.display     = 'flex';
      document.getElementById('user-email').textContent      = user.email;
      const brand = localStorage.getItem('lailai_brand') || '萊萊蔥抓餅';
      if (typeof initApp === 'function') initApp(brand);
      window._fbReady = true;
      document.dispatchEvent(new Event('firebase-ready'));
    } else {
      document.getElementById('login-screen').style.display  = 'flex';
      document.getElementById('main-header').style.display   = 'none';
      document.getElementById('main-tabs').style.display     = 'none';
    }
  });

  window.doLogin = async function() {
    const email    = document.getElementById('login-email').value.trim();
    const password = document.getElementById('login-password').value;
    const errEl    = document.getElementById('login-error');
    errEl.textContent = '';
    try {
      await signInWithEmailAndPassword(auth, email, password);
    } catch(e) {
      errEl.textContent = '❌ 帳號或密碼錯誤，請再試一次';
    }
  };

  window.doLogout = async function() {
    if (!confirm('確定登出？')) return;
    await signOut(auth);
  };
</script>

<style>
* { -webkit-tap-highlight-color: transparent; touch-action: manipulation; box-sizing: border-box; margin: 0; padding: 0; }
button, .tab, .staff-chip, .mode-btn, .btn-load, .btn-submit, .add-btn { cursor: pointer; user-select: none; }

@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&display=swap');

:root {
  --red: #E8680A;
  --red-light: #fff4ec;
  --orange: #FF9A3C;
  --gold: #D4780A;
  --ink: #1a1a1a;
  --muted: #6b6b6b;
  --border: #eeddc8;
  --bg: #fffaf5;
  --white: #ffffff;
  --green: #2d7d46;
  --green-light: #edfaf2;
  --warn: #c0460a;
  --warn-light: #fff0e8;
  --blue: #1a6fb5;
  --blue-light: #edf4ff;
}

body { font-family: 'Noto Sans TC', sans-serif; background: var(--bg); color: var(--ink); min-height: 100vh; }

/* SETUP */
#setup-screen {
  position: fixed; inset: 0; background: var(--red); display: flex;
  align-items: center; justify-content: center; z-index: 9999; padding: 24px;
}
.setup-box {
  background: white; border-radius: 20px; padding: 32px 28px;
  max-width: 400px; width: 100%; text-align: center;
}
.setup-box h2 { font-size: 22px; font-weight: 900; color: var(--red); margin-bottom: 8px; }
.setup-box p { font-size: 13px; color: var(--muted); margin-bottom: 24px; }
.setup-box input { width: 100%; padding: 12px; border: 2px solid var(--border); border-radius: 10px; font-size: 15px; font-family: inherit; outline: none; text-align: center; font-weight: 700; margin-bottom: 12px; }
.setup-box input:focus { border-color: var(--red); }
.setup-box button { width: 100%; padding: 14px; background: var(--red); color: white; border: none; border-radius: 10px; font-size: 15px; font-weight: 900; font-family: inherit; cursor: pointer; }

/* HEADER */
.header {
  background: var(--red); color: white; padding: 16px 20px 14px;
  display: flex; align-items: center; justify-content: space-between;
  position: sticky; top: 0; z-index: 100;
  box-shadow: 0 2px 12px rgba(232,104,10,.35);
}
.header-title { font-size: 18px; font-weight: 900; letter-spacing: .5px; }
.header-sub { font-size: 11px; opacity: .8; margin-top: 2px; }
.header-right { text-align: right; }
.header-date { font-size: 13px; font-weight: 700; }
#sync-status { font-size: 11px; margin-top: 2px; opacity: 0; transition: opacity .5s; }
.sync-btn { background: rgba(255,255,255,.2); border: none; color: white; font-size: 11px; padding: 3px 8px; border-radius: 4px; cursor: pointer; font-family: inherit; margin-top: 3px; }

/* TABS */
.tabs {
  display: flex; background: white;
  border-bottom: 2px solid var(--border);
  position: sticky; top: 64px; z-index: 99;
  overflow-x: auto;
}
.tabs::-webkit-scrollbar { display: none; }
.tab {
  flex-shrink: 0; padding: 12px 10px; text-align: center;
  font-size: 12px; font-weight: 700; color: var(--muted);
  cursor: pointer; border-bottom: 3px solid transparent; transition: all .2s;
  white-space: nowrap;
}
.tab.active { color: var(--red); border-bottom-color: var(--red); }

/* SECTIONS */
.section { display: none; padding: 16px; }
.section.active { display: block; }

/* CARD */
.card { background: white; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 14px; overflow: hidden; }
.card-header {
  padding: 12px 16px; font-size: 13px; font-weight: 900; letter-spacing: .5px;
  display: flex; align-items: center; gap: 8px;
  border-bottom: 1px solid var(--border);
}
.card-header.red { background: var(--red); color: white; }
.card-header.green { background: var(--green); color: white; }
.card-header.gold { background: var(--gold); color: white; }
.card-header.orange { background: var(--orange); color: white; }
.card-header.mgmt { background: #5a6a7a; color: white; }
.card-header.blue { background: var(--blue); color: white; }
.card-header.dark { background: var(--ink); color: white; }

/* DATE BAR */
.date-bar {
  display: flex; align-items: center; gap: 10px; margin-bottom: 14px;
  background: white; padding: 12px 16px; border-radius: 10px;
  border: 1px solid var(--border);
}
.date-bar label { font-size: 12px; color: var(--muted); font-weight: 700; white-space: nowrap; }
.date-bar input { flex: 1; border: 1px solid var(--border); border-radius: 6px; padding: 6px 10px; font-size: 14px; font-family: inherit; outline: none; }
.btn-load { background: var(--red); color: white; border: none; border-radius: 7px; padding: 7px 14px; font-size: 13px; font-weight: 700; font-family: inherit; cursor: pointer; white-space: nowrap; }

/* EXPENSE TABLE */
.expense-table { width: 100%; border-collapse: collapse; }
.expense-table th { background: #f5f0ea; font-size: 11px; font-weight: 700; color: var(--muted); padding: 8px 10px; text-align: left; }
.expense-table td { padding: 9px 10px; font-size: 13px; border-bottom: 1px solid #f0ebe4; vertical-align: middle; }
.expense-table tr:last-child td { border-bottom: none; }
.expense-table .amt { font-weight: 700; text-align: right; font-size: 14px; }
.warn-badge { display: inline-block; background: var(--warn-light); color: var(--warn); font-size: 10px; font-weight: 700; padding: 2px 5px; border-radius: 4px; margin-left: 4px; }
.expense-table .note { font-size: 11px; color: var(--warn); display: block; margin-top: 2px; }
.total-row td { background: var(--red-light); font-weight: 900; font-size: 15px; color: var(--red); border-top: 2px solid var(--red) !important; }

/* PERFORMANCE */
.perf-grid { display: grid; grid-template-columns: 1fr 1fr; }
.perf-cell { padding: 14px 16px; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); }
.perf-cell:nth-child(2n) { border-right: none; }
.perf-cell:nth-last-child(-n+2) { border-bottom: none; }
.perf-label { font-size: 11px; color: var(--muted); font-weight: 700; margin-bottom: 4px; }
.perf-value { font-size: 22px; font-weight: 900; }
.perf-value.green { color: var(--green); }
.perf-value.red { color: var(--red); }
.perf-unit { font-size: 12px; color: var(--muted); margin-left: 2px; }

/* STAFF TABLE */
.staff-table { width: 100%; border-collapse: collapse; }
.staff-table th { background: #f5f0ea; font-size: 11px; font-weight: 700; color: var(--muted); padding: 8px 10px; text-align: left; }
.staff-table td { padding: 9px 10px; font-size: 13px; border-bottom: 1px solid #f0ebe4; }
.staff-table tr:last-child td { border-bottom: none; }
.badge { display: inline-block; font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 20px; }
.badge-work { background: var(--green-light); color: var(--green); }
.badge-leave { background: #ffeaea; color: var(--red); }
.badge-absent { background: #f5f5f5; color: #999; }
.hours-badge { font-size: 12px; font-weight: 700; color: var(--orange); background: #fff7ec; padding: 2px 7px; border-radius: 20px; }

/* ADD / FORM */
.add-btn { width: 100%; padding: 12px; background: white; border: 2px dashed var(--border); border-radius: 10px; font-family: inherit; font-size: 14px; color: var(--muted); cursor: pointer; margin-bottom: 14px; font-weight: 700; transition: all .2s; }
.add-btn:hover { border-color: var(--red); color: var(--red); background: var(--red-light); }

/* MODAL */
.modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 200; padding: 20px; align-items: flex-end; }
.modal-overlay.open { display: flex; }
.modal { background: white; border-radius: 16px 16px 0 0; padding: 20px; width: 100%; max-height: 90vh; overflow-y: auto; position: fixed; bottom: 0; left: 0; right: 0; animation: slideUp .25s ease; }
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
.modal-title { font-size: 16px; font-weight: 900; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
.modal-close { font-size: 20px; cursor: pointer; color: var(--muted); }

.form-group { margin-bottom: 14px; }
.form-label { font-size: 12px; font-weight: 700; color: var(--muted); margin-bottom: 6px; display: block; }
.form-input, .form-select { width: 100%; padding: 10px 12px; border: 1.5px solid var(--border); border-radius: 8px; font-size: 14px; font-family: inherit; outline: none; transition: border-color .2s; }
.form-input:focus, .form-select:focus { border-color: var(--red); }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.btn-submit { width: 100%; padding: 14px; background: var(--red); color: white; border: none; border-radius: 10px; font-size: 15px; font-weight: 900; font-family: inherit; cursor: pointer; margin-top: 4px; }

/* REPORT */
.report-card { background: white; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 14px; overflow: hidden; }
.report-header { padding: 12px 16px; font-size: 13px; font-weight: 900; background: var(--ink); color: white; display: flex; justify-content: space-between; align-items: center; }
.report-row { display: flex; justify-content: space-between; padding: 10px 16px; font-size: 13px; border-bottom: 1px solid #f0ebe4; align-items: center; }
.report-row:last-child { border-bottom: none; }
.report-key { color: var(--muted); }
.report-val { font-weight: 700; }
.profit-positive { color: var(--green); font-size: 18px; font-weight: 900; }
.profit-negative { color: var(--red); font-size: 18px; font-weight: 900; }

/* BAR CHART */
.bar-wrap { padding: 14px 16px; }
.bar-row { margin-bottom: 10px; }
.bar-label { font-size: 12px; color: var(--muted); margin-bottom: 4px; display: flex; justify-content: space-between; }
.bar-track { background: #f0ebe4; border-radius: 4px; height: 10px; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 4px; background: var(--red); transition: width .6s ease; }
.bar-fill.green { background: var(--green); }
.bar-fill.blue { background: var(--blue); }

/* ALERT BOXES */
.alert-box { padding: 12px 16px; border-radius: 10px; margin-bottom: 10px; font-size: 13px; display: flex; gap: 10px; align-items: flex-start; }
.alert-good { background: var(--green-light); border: 1px solid #b0e8c4; }
.alert-ok { background: #fffbea; border: 1px solid #ffe58a; }
.alert-bad { background: var(--warn-light); border: 1px solid #ffbda0; }

/* MODE BAR */
.mode-bar { display: flex; gap: 8px; margin-bottom: 14px; }
.mode-btn { flex: 1; padding: 9px 4px; border: 1.5px solid var(--border); border-radius: 8px; background: white; font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer; color: var(--muted); transition: all .2s; }
.mode-btn.active { border-color: var(--red); background: var(--red-light); color: var(--red); }

/* STAFF CHIPS */
.staff-chip { padding: 8px 14px; border-radius: 20px; border: 2px solid var(--border); background: white; font-size: 13px; font-weight: 700; font-family: inherit; cursor: pointer; color: var(--ink); transition: all .15s; }
.staff-chip.selected { background: var(--red); border-color: var(--red); color: white; }
.staff-list-item { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--border); font-size: 14px; font-weight: 700; }
.btn-remove-staff { background: none; border: none; color: var(--muted); font-size: 18px; cursor: pointer; padding: 0 4px; }

/* EMPTY */
.empty { text-align: center; padding: 30px 20px; color: var(--muted); }
.empty-icon { font-size: 36px; margin-bottom: 8px; }
.empty-text { font-size: 13px; }

/* ANNUAL */
.month-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 16px; border-bottom: 1px solid #f0ebe4; font-size: 13px; }
.month-row:last-child { border-bottom: none; }
.growth-up { color: var(--green); font-size: 11px; font-weight: 700; }
.growth-down { color: var(--red); font-size: 11px; font-weight: 700; }

/* STATS GRID */
.stats-grid { display: grid; grid-template-columns: 1fr 1fr; }
.stat-cell { padding: 14px 16px; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); }
.stat-cell:nth-child(2n) { border-right: none; }
.stat-cell:nth-last-child(-n+2) { border-bottom: none; }
.stat-label { font-size: 11px; color: var(--muted); font-weight: 700; margin-bottom: 4px; }
.stat-value { font-size: 18px; font-weight: 900; }

/* PENDING DOT */
.pending-dot { display: inline-block; width: 8px; height: 8px; background: var(--warn); border-radius: 50%; margin-left: 4px; vertical-align: middle; }

/* LOADING */
#loading-overlay { position: fixed; inset: 0; background: rgba(255,250,245,.9); z-index: 500; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 12px; }
.spinner { width: 36px; height: 36px; border: 3px solid var(--border); border-top-color: var(--red); border-radius: 50%; animation: spin .7s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

.divider-label { font-size: 11px; color: var(--muted); font-weight: 700; letter-spacing: .5px; padding: 8px 16px 4px; background: #f9f6f1; border-bottom: 1px solid var(--border); border-top: 1px solid var(--border); }
</style>
</head>
<body>

<!-- SETUP (hidden) -->
<div id="setup-screen" style="display:none">

<!-- LOADING -->
<div id="loading-overlay" style="display:none">
  <div class="spinner"></div>
  <div style="font-size:13px;color:var(--muted)">載入中...</div>
</div>

<!-- HEADER -->
<div class="header" id="main-header" style="display:none">
  <div>
    <div class="header-title" id="header-brand">🥟 萊萊蔥抓餅</div>
    <div class="header-sub">每日營運記錄系統</div>
  </div>
  <div class="header-right">
    <div class="header-date" id="headerDate"></div>
    <span id="user-email" style="font-size:10px;opacity:.7;display:block"></span>
    <div id="sync-status"></div>
    <div style="display:flex;gap:4px;margin-top:2px">
      <button class="sync-btn" onclick="syncAll()">⟳ 同步</button>
      <button class="sync-btn" onclick="doLogout()" style="background:rgba(255,255,255,.12)">登出</button>
    </div>
  </div>
</div>

<!-- TABS -->
<div class="tabs" id="main-tabs" style="display:none">
  <div class="tab active" onclick="switchTab('expense',this)">💰 支出</div>
  <div class="tab" onclick="switchTab('performance',this)">📊 戰績</div>
  <div class="tab" onclick="switchTab('staff',this)">👥 人員</div>
  <div class="tab" onclick="switchTab('report',this)">📋 報表</div>
  <div class="tab" onclick="switchTab('annual',this)">📈 年度</div>
  <div class="tab" onclick="switchTab('search',this)">🔍 搜尋</div>
</div>

<!-- ═══════════ 支出 TAB ═══════════ -->
<div class="section active" id="tab-expense">
  <div class="date-bar">
    <label>日期</label>
    <input type="date" id="expenseDate">
    <button class="btn-load" onclick="loadDay()">載入</button>
  </div>
  <div class="mode-bar">
    <button class="mode-btn active" id="mode-view" onclick="setMode('view')">📋 查看</button>
    <button class="mode-btn" id="mode-add" onclick="setMode('add')">➕ 新增</button>
  </div>
  <div id="expenseList"></div>
  <div id="addExpenseArea" style="display:none">
    <button class="add-btn" onclick="openModal('expense')">＋ 新增支出項目</button>
  </div>
</div>

<!-- ═══════════ 戰績 TAB ═══════════ -->
<div class="section" id="tab-performance">
  <div class="date-bar">
    <label>日期</label>
    <input type="date" id="perfDate">
    <button class="btn-load" onclick="loadPerfDay()">載入</button>
  </div>
  <div class="mode-bar">
    <button class="mode-btn active" id="perfmode-view" onclick="setPerfMode('view')">📋 查看</button>
    <button class="mode-btn" id="perfmode-add" onclick="setPerfMode('add')">➕ 新增</button>
  </div>
  <div id="perfDisplay"></div>
  <div id="addPerfArea" style="display:none">
    <button class="add-btn" onclick="openModal('perf')">＋ 填寫當日戰績</button>
  </div>
</div>

<!-- ═══════════ 人員 TAB ═══════════ -->
<div class="section" id="tab-staff">
  <div class="date-bar">
    <label>日期</label>
    <input type="date" id="staffDate">
    <button class="btn-load" onclick="loadStaffDay()">載入</button>
  </div>
  <div class="mode-bar">
    <button class="mode-btn active" id="staffmode-view" onclick="setStaffMode('view')">📋 查看</button>
    <button class="mode-btn" id="staffmode-add" onclick="setStaffMode('add')">➕ 新增</button>
  </div>
  <div id="staffDisplay"></div>
  <div id="addStaffArea" style="display:none">
    <button class="add-btn" onclick="openModal('staff')">＋ 新增出勤記錄</button>
  </div>
</div>

<!-- ═══════════ 月報表 TAB ═══════════ -->
<div class="section" id="tab-report">
  <div class="date-bar">
    <label>月份</label>
    <input type="month" id="reportMonth">
    <button class="btn-load" onclick="generateReport()">產生</button>
  </div>
  <div id="reportContent"></div>
</div>

<!-- ═══════════ 年度報告 TAB ═══════════ -->
<div class="section" id="tab-annual">
  <div class="date-bar" style="gap:8px">
    <label>年份</label>
    <select id="annual-year" class="form-select" style="flex:1;padding:6px 10px;font-size:14px">
    </select>
    <button class="btn-load" onclick="renderAnnual()">產生</button>
  </div>

  <!-- 內部分頁 -->
  <div class="mode-bar" style="grid-template-columns:1fr 1fr 1fr;display:grid">
    <button class="mode-btn active" id="an-tab-overview" onclick="switchAnnualTab('overview',this)">月度總覽</button>
    <button class="mode-btn" id="an-tab-compare" onclick="switchAnnualTab('compare',this)">月份比較</button>
    <button class="mode-btn" id="an-tab-yearly" onclick="switchAnnualTab('yearly',this)">年度對比</button>
  </div>

  <div id="annual-overview"></div>
  <div id="annual-compare" style="display:none">
    <div class="card">
      <div class="card-header blue">🔀 選擇兩個月份比較</div>
      <div style="padding:14px 16px;display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div>
          <div class="form-label">月份 A</div>
          <input type="month" class="form-input" id="cmp-a">
        </div>
        <div>
          <div class="form-label">月份 B</div>
          <input type="month" class="form-input" id="cmp-b">
        </div>
      </div>
      <div style="padding:0 16px 16px">
        <button class="btn-submit" onclick="renderCompare()">比較</button>
      </div>
    </div>
    <div id="compare-result"></div>
  </div>
  <div id="annual-yearly" style="display:none"></div>
</div>

<!-- ═══════════ 搜尋 TAB ═══════════ -->
<div class="section" id="tab-search">
  <div class="card" style="margin-bottom:14px">
    <div style="padding:14px 16px">
      <div style="display:flex;gap:8px;margin-bottom:10px">
        <input type="text" class="form-input" id="search-keyword" placeholder="輸入品項名稱，例：雞蛋" style="flex:1" oninput="runSearch()">
        <button class="btn-load" onclick="runSearch()">搜尋</button>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
